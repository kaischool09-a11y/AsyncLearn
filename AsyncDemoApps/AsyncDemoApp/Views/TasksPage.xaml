<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ViewModels"
    x:Class="Views.TasksPage"
    x:DataType="vm:TasksViewModel"
    FlowDirection="RightToLeft"
    Title="{Binding Title}">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="15">

        <Button Grid.Row="0"
                Text="חזרה לדף הבית"
                Command="{Binding GoHomeCommand}"
                BackgroundColor="Gray" />

        <Button Grid.Row="1"
                Text="Task Start"
                Command="{Binding StartTaskCommand}"
                BackgroundColor="Green"
                TextColor="White"
                HeightRequest="50" />

        <VerticalStackLayout Grid.Row="2"
                             Spacing="5">

            <Label Text="Completed Tasks:"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="{Binding CompletedTasksCount}"
                   FontSize="22" />

            <Button Text="Clear All"
                    Command="{Binding ClearAllCommand}"
                    BackgroundColor="DarkRed"
                    TextColor="White" />

        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Tasks}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="vm:TaskItemViewModel">

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          Padding="10"
                          ColumnSpacing="10"
                          RowSpacing="8">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="16" />

                        <ProgressBar Grid.Row="1"
                                     Grid.Column="0"
                                     Progress="{Binding Progress}"
                                     ProgressColor="Green"
                                     VerticalOptions="Center" />

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                Text="Cancel"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsCancelEnabled}"
                                BackgroundColor="Red"
                                TextColor="White"
                                VerticalOptions="Center" />

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Label Grid.Row="4"
               Text="Asynchronous Tasks Demo"
               HorizontalOptions="Center"
               TextColor="Gray" />

    </Grid>

</ContentPage>
